# personas.env — editar a mano. Fuente de verdad del mapeo persona→vendor/modelo + departamentos.

PROJECT_DIR="$HOME/Programacion/proyectos/bmad-herdr-demo"
LABEL="herdr-bmad"

# PERSONAS: "nombre|kind|vendor_args|rol"
#   kind        → herdr agent start --kind <kind>  (claude, opencode, codex, gemini, hermes, ...)
#   vendor_args → TODO lo que va después de `--` (flag de modelo del vendor)
#   el primero DEBE ser "orquestador"
PERSONAS=(
  "orquestador|claude|--model opus|Orquestador top — rutea + aprueba"
  "analyst|opencode|-m opencode-go/deepseek-v4-flash|Mary — análisis/brainstorm"
  "architect|claude|--model sonnet|Winston — arquitectura/spine"
  "pm|claude|--model sonnet|John — producto/PRD/epics"
  "dev|opencode|-m opencode-go/kimi-k2.7-code|Amelia — build"
  "reviewer|opencode|-m opencode-go/deepseek-v4-pro|Revisor — code review/QA"
  "ux|opencode|-m opencode-go/deepseek-v4-flash|Sally — UX"
)

# DEPARTAMENTOS: "tab_label|persona1,persona2,..."
#   El orquestador vive en el tab default (root pane del workspace).
#   Layout por tab: hasta 4 columnas × 2 filas (8 panes máx).
DEPARTAMENTOS=(
  "producto|architect,pm,analyst"
  "desarrollo|dev"
  "qa|reviewer"
  "diseno|ux"
)
